{
  "simplefin_access_url": "https://USERNAME:PASSWORD@bridge.simplefin.org/simplefin",
  "ezbookkeeping_cli": "ezbookkeeping",
  "ezbookkeeping_username": "your_username",
  "ezbookkeeping_working_directory": null,
  "timezone": "America/Los_Angeles",
  "date_only_time": "00:00:00",
  "positive_is_income": false,
  "lookback_days": 7,
  "overlap_days": 5,
  "include_pending": true,
  "request_timeout_seconds": 60,
  "default_expense_parent": "Misc",
  "default_expense_category": "Uncategorized",
  "default_income_parent": "Misc",
  "default_income_category": "Uncategorized",
  "account_map": {
    "SIMPLEFIN_ACCOUNT_ID": "ezBookkeeping Account Name"
  },
  "state_file": "sync_state.json",
  "error_log": "bridge_error.log",
  "ezbookkeeping_db": "/path/to/ezbookkeeping/data/ezbookkeeping.db",
  "keep_csv_path": null,
  "max_seen_ids": 0,
  "reconcile_tolerance_cents": 1,
  "reconcile_max_adjust_cents": 500000,
  "use_available_balance": false,
  "reconcile_expense_parent": "Misc",
  "reconcile_expense_category": "Uncategorized",
  "reconcile_income_parent": "Misc",
  "reconcile_income_category": "Uncategorized"
}
